{
  "datasets": [
    {
      "name": "5e1494a8",
      "displayName": "ds_top_categories",
      "queryLines": [
        "SELECT\r\n",
        "  p.product_category_name     AS category,\r\n",
        "  ROUND(SUM(f.item_total), 2) AS revenue,\r\n",
        "  COUNT(DISTINCT f.order_id)  AS orders\r\n",
        "FROM retail_lakehouse.gold.fact_orders f\r\n",
        "JOIN retail_lakehouse.gold.dim_product p ON f.product_sk = p.product_sk\r\n",
        "GROUP BY p.product_category_name\r\n",
        "ORDER BY revenue DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "d9aa363c",
      "displayName": "ds_sales",
      "queryLines": [
        "SELECT\r\n",
        "  d.date                           AS order_date,\r\n",
        "  d.year,\r\n",
        "  d.month,\r\n",
        "  p.product_category_name          AS category,\r\n",
        "  c.customer_state                 AS state,\r\n",
        "  f.order_id,\r\n",
        "  c.customer_unique_id,            -- hashed by the secure view (PII masked)\r\n",
        "  f.item_total,\r\n",
        "  f.price,\r\n",
        "  f.freight_value,\r\n",
        "  f.delivery_days,\r\n",
        "  CAST(f.is_late_delivery AS INT)  AS late_flag\r\n",
        "FROM retail_lakehouse.gold.fact_orders f\r\n",
        "JOIN retail_lakehouse.gold.dim_date d              ON f.purchase_date_key = d.date_key\r\n",
        "JOIN retail_lakehouse.gold.dim_product p           ON f.product_sk = p.product_sk\r\n",
        "JOIN retail_lakehouse.gold.v_dim_customer_secure c ON f.customer_sk = c.customer_sk"
      ]
    },
    {
      "name": "70f732ba",
      "displayName": "ds_quality_runs",
      "queryLines": [
        "SELECT\r\n",
        "  job_run_id,\r\n",
        "  MIN(checked_at)                              AS checked_at,\r\n",
        "  COUNT(*)                                     AS checks_run,\r\n",
        "  SUM(CASE WHEN passed THEN 1 ELSE 0 END)      AS checks_passed,\r\n",
        "  SUM(CASE WHEN passed THEN 0 ELSE 1 END)      AS checks_failed\r\n",
        "FROM retail_lakehouse.gold.data_quality_results\r\n",
        "GROUP BY job_run_id"
      ]
    },
    {
      "name": "eee3383a",
      "displayName": "ds_latest_checks",
      "queryLines": [
        "SELECT check_name, layer, actual_value, rule,\r\n",
        "       CASE WHEN passed THEN '✅ Pass' ELSE '❌ Fail' END AS result,\r\n",
        "       checked_at\r\n",
        "FROM retail_lakehouse.gold.data_quality_results\r\n",
        "WHERE job_run_id = (\r\n",
        "  SELECT job_run_id FROM retail_lakehouse.gold.data_quality_results\r\n",
        "  ORDER BY checked_at DESC LIMIT 1\r\n",
        ")\r\n",
        "ORDER BY layer, check_name"
      ]
    },
    {
      "name": "41eaa77a",
      "displayName": "ds_table_freshness",
      "queryLines": [
        "SELECT 'bronze.orders_raw' AS table_name, COUNT(*) AS row_count, MAX(_ingested_at)            AS last_activity FROM retail_lakehouse.bronze.orders_raw\r\n",
        "UNION ALL\r\n",
        "SELECT 'silver.orders',    COUNT(*),                               MAX(_ingested_at)                            FROM retail_lakehouse.silver.orders\r\n",
        "UNION ALL\r\n",
        "SELECT 'gold.fact_orders', COUNT(*),                               MAX(order_purchase_timestamp)                FROM retail_lakehouse.gold.fact_orders\r\n",
        "UNION ALL\r\n",
        "SELECT 'gold.dim_customer', COUNT(*),                              MAX(effective_from)                          FROM retail_lakehouse.gold.dim_customer"
      ]
    }
  ],
